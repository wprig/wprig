{
  "$schema": "./tokens.schema.json",
  "meta": {
    "version": 2,
    "colorSpace": "hex",
    "darkMode": "media",
    "generator": "wp-rig",
    "fluid": {
      "enabled": true,
      "minViewport": "320px",
      "maxViewport": "1280px",
      "minScale": 0.75
    }
  },
  "primitives": {
    "color": {
      "brand": { "500": "#e36d60" },
      "accent": { "500": "#41848f" },
      "neutral": {
        "0": "#fff",
        "100": "#ecf0f1",
        "500": "#95a5a6",
        "700": "#333",
        "900": "#1c2833"
      },
      "red": { "500": "#c0392b" },
      "green": { "500": "#27ae60" },
      "blue": { "500": "#2980b9" },
      "yellow": { "500": "#f1c40f" }
    },
    "layout": { "content": "45rem", "wide": "64rem" },
    "space": { "base": "1rem" },
    "font": {
      "family": {
        "base": "\"Open Sans\", \"Helvetica Neue\", \"Arial\", sans-serif",
        "highlight": "\"Roboto Condensed\", \"Helvetica Neue\", \"Arial Narrow\", sans-serif"
      },
      "size": {
        "small": "0.8rem",
        "base": "1rem",
        "large": "1.8rem",
        "xlarge": "2.4rem"
      },
      "leading": { "base": "1.4" }
    },
    "breakpoint": { "mobile": "480px", "tablet": "782px" },
    "hue": { "accent": 32, "accent-2": 208 },
    "alpha": { "weak": "15%", "medium": "40%", "strong": "70%" }
  },
  "semantic": {
    "surface": { "light": "{primitives.color.neutral.0}", "dark": "#121212" },
    "surface-content": { "light": "{primitives.color.neutral.0}", "dark": "#181818" },
    "surface-subtle": { "light": "#f6f6f6", "dark": "#333333" },
    "surface-header": { "light": "#f6f6f6", "dark": "#1a1a1a" },
    "surface-footer": { "light": "#fbfbfb", "dark": "#1a1a1a" },
    "text": { "light": "{primitives.color.neutral.700}", "dark": "#ffffff" },
    "text-muted": { "light": "#6c7781", "dark": "#a8a8a8" },
    "border": { "light": "#cccccc", "dark": "#333333" },
    "border-strong": { "light": "{primitives.color.neutral.700}", "dark": "#cccccc" },
    "accent": { "light": "{primitives.color.brand.500}", "dark": "{primitives.color.brand.500}" },
    "accent-secondary": { "light": "{primitives.color.accent.500}", "dark": "{primitives.color.accent.500}" },
    "link": { "light": "#0073aa", "dark": "#4e9efd" },
    "link-hover": { "light": "#00a0d2", "dark": "#bbdfff" },
    "link-visited": { "light": "{primitives.color.neutral.700}", "dark": "#bbdfff" },
    "focus-ring": { "light": "#0073aa", "dark": "#7cc0ff" },
    "code-surface": { "light": "#eeeeee", "dark": "#2b2b2b" },
    "code-text": { "light": "{primitives.color.neutral.700}", "dark": "#e6e6e6" },
    "quote-border": { "light": "#000000", "dark": "#000000" },
    "quote-citation": { "light": "#6c7781", "dark": "#6c7781" },
    "state": {
      "danger": { "light": "{primitives.color.red.500}", "dark": "#ff8a80" },
      "success": { "light": "{primitives.color.green.500}", "dark": "#7ee2a8" },
      "warning": { "light": "{primitives.color.yellow.500}", "dark": "#ffd95e" },
      "info": { "light": "{primitives.color.blue.500}", "dark": "#8abfff" }
    }
  }
}
