{
  "name": "wprig",
  "version": "3.4.2",
  "description": "A progressive theme development rig for WordPress.",
  "author": "The WP Rig Contributors",
  "license": "GPL-3.0-or-later",
  "main": "index.php",
  "homepage": "https://github.com/wprig/wprig#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wprig/wprig.git"
  },
  "engines": {
    "node": ">=20.13.1",
    "npm": ">=10.5.2"
  },
  "bugs": {
    "url": "https://github.com/wprig/wprig/issues"
  },
  "ai": {
    "protocol": "./AGENTS.md",
    "skills": "./.ai/skills/"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@wordpress/block-editor": "^15.23.0",
    "@wordpress/blocks": "^15.25.0",
    "@wordpress/components": "^28.13.0",
    "@wordpress/create-block": "^4.95.0",
    "@wordpress/data": "^10.52.0",
    "@wordpress/e2e-test-utils-playwright": "^1.52.0",
    "@wordpress/eslint-plugin": "^21.6.0",
    "@wordpress/scripts": "^30.27.0",
    "@wordpress/server-side-render": "^6.28.0",
    "prettier": "npm:wp-prettier@3.0.3",
    "ansi-colors": "^4.1.3",
    "archiver": "^6.0.2",
    "autoprefixer": "^9.8.8",
    "browser-sync": "^2.29.3",
    "browserslist": "^4.28.7",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "create-cert": "^1.0.6",
    "cross-env": "^5.2.1",
    "deepmerge": "^4.3.1",
    "del": "^8.0.1",
    "esbuild": "^0.25.12",
    "esbuild-loader": "^2.21.0",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "esm": "^3.2.25",
    "fancy-log": "^1.3.3",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.0",
    "globals": "^15.15.0",
    "inquirer": "^9.3.8",
    "jest": "^29.7.0",
    "jest-expect-message": "^1.1.3",
    "lightningcss": "^1.33.0",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.3",
    "stylelint": "^16.26.1",
    "svgo": "^3.3.4",
    "tiny-lr": "^2.0.0",
    "turndown": "^7.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vinyl": "^2.2.1"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "jest-expect-message"
    ]
  },
  "overrides": {
    "react-autosize-textarea": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "type": "module",
  "scripts": {
    "editor-support": "node node/editorSupport.js",
    "rig-init": "npm install --loglevel=error --no-audit --no-fund && composer install --quiet && node scripts/cli.js init",
    "rig-init:bun": "bun install --loglevel=error --no-audit --no-fund && composer install --quiet && node scripts/cli.js init",
    "generateCert": "node scripts/cli.js generateCert",
    "build:js": "node build-js.js",
    "dev:js": "node build-js.js --dev",
    "lint:js": "cross-env ESLINT_USE_FLAT_CONFIG=true eslint \"assets/js/src/**/*.{js,jsx,ts,tsx}\"",
    "build:css": "node build-css.js",
    "dev:css": "node build-css.js --dev",
    "lint:css": "node lint-css.js",
    "fix:css": "node lint-css.js --fix",
    "lint:blocks": "node scripts/cli.js lint:blocks",
    "watch:js": "node build-js.js",
    "watch:css": "npm run build:css && chokidar 'src/styles/**/*.css' -c 'npm run build:css'",
    "dev": "node scripts/cli.js dev",
    "dev:modern": "node scripts/dev-modern.js",
    "dev:modern:debug": "cross-env WPRIG_DEBUG=1 node scripts/dev-modern.js --debug",
    "build": "node scripts/cli.js build",
    "build:blocks": "node scripts/build-all-blocks.js",
    "start:blocks": "node scripts/build-all-blocks.js --watch",
    "start": "node scripts/start.js",
    "build:phpcs": "node scripts/cli.js build --phpcs",
    "images": "node scripts/cli.js images",
    "bundle": "cross-env NODE_ENV=production node scripts/cli.js bundle",
    "bundle:wporg": "cross-env NODE_ENV=production node scripts/cli.js bundle:wporg",
    "bundle:phpcs": "cross-env NODE_ENV=production node scripts/cli.js bundle --phpcs",
    "bundle:check-all": "cross-env NODE_ENV=production node scripts/cli.js bundle --phpcs",
    "audit:accessibility": "playwright test",
    "theme:enable-blocks": "node scripts/enable-blocks.js",
    "theme:setup-wporg": "node scripts/setup-wporg.js",
    "test:e2e": "playwright test",
    "test:scripts": "cross-env NODE_OPTIONS=--experimental-vm-modules jest scripts/tests/theme-review/*.test.js scripts/tests/*.test.js",
    "test:prod-build": "node scripts/tests/prod-build/prod-build.setup.js && npm run bundle && cross-env NODE_ENV=production NODE_OPTIONS=--experimental-vm-modules jest scripts/tests/prod-build/prod-build.test.js && cross-env NODE_ENV=production node scripts/tests/prod-build/prod-build.teardown.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:codegen": "playwright codegen http://localhost:8888",
    "test:e2e:screenshot": "playwright test tests/e2e/specs/screenshot.spec.ts --update-snapshots",
    "test:perf": "lhci autorun",
    "test:perf:collect": "lhci collect",
    "test:perf:report": "lhci open",
    "ai:check": "npm run test:e2e && npm run test:e2e:screenshot && npm run lint:css && npm run lint:js",
    "audit:metadata": "node scripts/theme-review/run.js --check=metadata",
    "audit:banned-files": "node scripts/theme-review/run.js --check=banned-files",
    "audit:plugin-territory": "node scripts/theme-review/run.js --check=plugin-territory",
    "audit:security-patterns": "node scripts/theme-review/run.js --check=security-patterns",
    "audit:remote-resources": "node scripts/theme-review/run.js --check=remote-resources",
    "audit:theme-check": "node scripts/theme-review/run.js --check=theme-check",
    "audit:i18n": "node scripts/theme-review/run.js --check=i18n-basic",
    "audit:theme-json": "node scripts/theme-review/run.js --check=theme-json",
    "audit:html-templates": "node scripts/theme-review/run.js --check=html-templates",
    "audit:theme-review": "node scripts/theme-review/run.js",
    "block:new": "node scripts/blocks.js block:new",
    "block:new:dynamic": "node scripts/blocks.js block:new --dynamic",
    "block:list": "node scripts/blocks.js block:list",
    "block:remove": "node scripts/blocks.js block:remove",
    "block:promote-plugin": "node scripts/blocks.js block:promote-plugin",
    "childify": "node node/childify.js",
    "setup-child": "npm run rig-init && npm run childify",
    "setup-child:bun": "bun run rig-init:bun && bun run childify",
    "block-based": "node scripts/convert-to-block-theme.js",
    "create-rig-component": "node node/create-component-wrapper.js",
    "mcp": "node bin/mcp-server/index.js",
    "get-dev-url": "node scripts/cli.js get-dev-url",
    "ai:setup": "node scripts/ai-setup.js",
    "inspect": "node .ai/tools/inspect.js",
    "rig": "node scripts/rig.js",
    "rig:list": "node scripts/rig.js list",
    "rig:search": "node scripts/rig.js search",
    "rig:add": "node scripts/rig.js add",
    "rig:remove": "node scripts/rig.js remove",
    "rig:update": "node scripts/rig.js update",
    "rig:prepare": "node scripts/rig.js prepare",
    "rig:test-component": "node scripts/rig.js test-component",
    "rig:check": "node scripts/rig.js check",
    "rig:pattern": "node scripts/rig.js pattern",
    "rig:localize": "node scripts/rig.js localize",
    "rig:compare": "node scripts/rig.js compare",
    "rig:tokens": "node scripts/propagate-tokens.js"
  },
  "dependencies": {
    "glob": "^11.1.0"
  }
}
