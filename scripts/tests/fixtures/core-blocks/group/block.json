{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "core/group",
	"title": "Group",
	"category": "design",
	"supports": {
		"anchor": true,
		"color": {
			"text": true,
			"background": true
		}
	},
	"attributes": {
		"tagName": {
			"type": "string",
			"default": "div"
		},
		"templateLock": {
			"type": [ "string", "boolean" ],
			"enum": [ "all", "insert", "contentOnly", false ]
		},
		"layout": {
			"type": "object"
		},
		"anchor": {
			"type": "string"
		}
	}
}
